rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow only authenticated content owners access
    match /presentation/{userId}/{documents=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /bandSessionCodes/{code} {
      // Join uses get by known code only — never allow collection listing.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    match /bandSessions/{sessionId} {
      // Followers subscribe to a known sessionId (from code lookup) — no listing.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.leaderId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.leaderId == request.auth.uid;
    }

    match /sheetEdits/{editId} {
      // Anyone with the edit id can read it (shared by link). Listing is only
      // for the owner's own edits, and the query must filter on ownerId.
      allow get: if true;
      allow list: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && isValidSheetEdits(request.resource.data);
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.fileId == resource.data.fileId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidSheetEdits(request.resource.data);
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    function isValidSheetEdits(data) {
      return data.keys().hasOnly(['ownerId', 'fileId', 'name', 'baseHash', 'edits', 'createdAt', 'updatedAt'])
        && data.fileId is string
        && data.name is string && data.name.size() <= 100
        && data.baseHash is string
        && data.edits is list && data.edits.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
  }
}